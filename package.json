{
  "name": "online-saler",
  "version": "0.1.0",
  "private": true,
  "description": "Second-hand Digital Platform monorepo.",
  "scripts": {
    "dev": "npm run dev -w @online-saler/storefront --",
    "check:repo": "node scripts/check-repo.mjs",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run db:generate && npm run build -w @online-saler/database && npm run build -w @online-saler/shared-types && npm run build -w @online-saler/business-rules && npm run build -w @online-saler/api",
    "dev:storefront": "npm run dev -w @online-saler/storefront",
    "dev:operations": "npm run dev -w @online-saler/operations",
    "dev:admin": "npm run dev -w @online-saler/admin",
    "dev:api": "npm run dev -w @online-saler/api",
    "dev:worker": "npm run dev -w @online-saler/worker",
    "db:generate": "npm run db:generate -w @online-saler/database",
    "db:migrate": "npm run db:migrate -w @online-saler/database",
    "db:deploy": "npm run db:deploy -w @online-saler/database",
    "db:push": "npm run db:push -w @online-saler/database",
    "db:push:staging": "npm run db:push -w @online-saler/database -- --skip-generate --accept-data-loss",
    "db:bootstrap-staging": "npm run db:push:staging && node packages/database/prisma/seed-staging-test-employee.mjs",
    "db:migrate-staging": "node scripts/deploy-staging-migrations.mjs",
    "db:cleanup-staging-test-data": "node scripts/cleanup-staging-test-data.mjs",
    "test": "npm run test:scripts && npm run test --workspaces --if-present",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "typecheck:api": "npm run typecheck -w @online-saler/database && npm run typecheck -w @online-saler/shared-types && npm run typecheck -w @online-saler/business-rules && npm run typecheck -w @online-saler/api",
    "start:api": "npm run start -w @online-saler/api",
    "ci": "npm run check:repo && npm run db:generate && npm run build && npm run test"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
