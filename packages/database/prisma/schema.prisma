generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeStatus {
  ACTIVE
  SUSPENDED
  LEFT
}

enum ActorType {
  EMPLOYEE
  SYSTEM
  CUSTOMER
  AFFILIATE
}

enum SourceApp {
  STOREFRONT
  OPERATIONS
  ADMIN
  API
  WORKER
}

enum ProductStatus {
  DRAFT
  PHOTOGRAPHED
  AI_PROCESSING
  AI_PROCESSED
  CALIBRATION_PENDING
  CALIBRATED
  BARCODE_ASSIGNED
  REVIEW_PENDING
  REWORK_REQUIRED
  APPROVED
  READY_FOR_STORAGE
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum ProductImageType {
  FRONT
  BACK
  LABEL
  DEFECT
  DETAIL
  SOCIAL_CARD
}

enum ProductGender {
  WOMEN
  MEN
  KIDS
  UNISEX
}

enum ConditionGrade {
  LIKE_NEW
  EXCELLENT
  GOOD
  FAIR
}

enum AIExtractionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum AIFieldDecisionSource {
  AI_PROPOSED
  HUMAN_ACCEPTED
  HUMAN_EDITED
  HUMAN_ENTERED
}

enum ReviewResult {
  APPROVED
  REWORK_REQUIRED
  REJECTED
}

enum MeasurementSource {
  AI_ACCEPTED
  HUMAN_EDITED
  HUMAN_ENTERED
}

enum DefectSeverity {
  MINOR
  MAJOR
}

enum InventoryItemStatus {
  PENDING_STOCK_IN
  AVAILABLE
  RESERVED
  PICKED
  PACKED
  DELIVERED
  RETURNED
  LOST
}

enum InventoryMovementType {
  LOCATION_ASSIGNED
  STOCK_IN
  MOVE
  ADJUST
}

model Employee {
  id                         String               @id @default(uuid())
  employeeCode               String               @unique
  name                       String
  phone                      String?              @unique
  status                     EmployeeStatus       @default(ACTIVE)
  roles                      EmployeeRole[]
  auditLogs                  AuditLog[]
  createdProducts            Product[]            @relation("ProductCreatedBy")
  approvedProducts           Product[]            @relation("ProductApprovedBy")
  uploadedProductImages      ProductImage[]       @relation("ProductImageUploadedBy")
  reviewedMeasurements       ProductMeasurement[] @relation("ProductMeasurementReviewedBy")
  reviewedAIFieldDecisions   AIFieldDecision[]    @relation("AIFieldDecisionReviewedBy")
  productReviews             ProductReview[]      @relation("ProductReviewReviewer")
  inventoryItemsCreated      InventoryItem[]      @relation("InventoryItemCreatedBy")
  inventoryMovements         InventoryMovement[]  @relation("InventoryMovementEmployee")
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String?
  employees   EmployeeRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  module      String
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model EmployeeRole {
  employeeId String
  roleId     String
  employee   Employee @relation(fields: [employeeId], references: [id])
  role       Role     @relation(fields: [roleId], references: [id])
  createdAt  DateTime @default(now())

  @@id([employeeId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
}

model AuditLog {
  id         String    @id @default(uuid())
  actorType  ActorType
  actorId    String?
  employee   Employee? @relation(fields: [actorId], references: [id])
  sourceApp  SourceApp
  module     String
  entityType String
  entityId   String?
  action     String
  beforeJson Json?
  afterJson  Json?
  reason     String?
  createdAt  DateTime  @default(now())

  @@index([module, entityType, entityId])
  @@index([actorType, actorId])
  @@index([createdAt])
}

model SystemSetting {
  key                 String   @id
  valueJson           Json
  scope               String   @default("GLOBAL")
  updatedByEmployeeId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Product {
  id                   String               @id @default(uuid())
  productCode          String               @unique
  barcode              String?              @unique
  status               ProductStatus        @default(DRAFT)
  title                String?
  category             String?
  subcategory          String?
  brand                String?
  color                String?
  gender               ProductGender?
  kidsAgeRange         String?
  tagSize              String?
  finalSizeLabel       String?
  conditionGrade       ConditionGrade?
  priceKsh             Int?
  labelPrintedAt       DateTime?
  createdByEmployeeId  String?
  approvedByEmployeeId String?
  createdBy            Employee?            @relation("ProductCreatedBy", fields: [createdByEmployeeId], references: [id])
  approvedBy           Employee?            @relation("ProductApprovedBy", fields: [approvedByEmployeeId], references: [id])
  images               ProductImage[]
  measurements         ProductMeasurement[]
  aiExtractions        AIExtraction[]
  defects              ProductDefect[]
  reviews              ProductReview[]
  inventoryItem        InventoryItem?
  inventoryMovements   InventoryMovement[]
  publishedAt          DateTime?
  unpublishedAt        DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([status, publishedAt])
  @@index([category, finalSizeLabel, priceKsh])
  @@index([category, subcategory])
  @@index([gender, kidsAgeRange])
  @@index([conditionGrade])
}

model WarehouseLocation {
  id             String              @id @default(uuid())
  locationCode   String              @unique
  active         Boolean             @default(true)
  note           String?
  inventoryItems InventoryItem[]
  movementsFrom  InventoryMovement[] @relation("MovementFromLocation")
  movementsTo    InventoryMovement[] @relation("MovementToLocation")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([active, locationCode])
}

model InventoryItem {
  id                  String              @id @default(uuid())
  productId           String              @unique
  barcode             String              @unique
  status              InventoryItemStatus @default(PENDING_STOCK_IN)
  locationId          String?
  checkedInAt         DateTime?
  createdByEmployeeId String?
  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  location            WarehouseLocation?  @relation(fields: [locationId], references: [id], onDelete: SetNull)
  createdBy           Employee?           @relation("InventoryItemCreatedBy", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  movements           InventoryMovement[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([status, locationId])
  @@index([createdByEmployeeId])
}

model InventoryMovement {
  id              String                @id @default(uuid())
  inventoryItemId String
  productId       String
  movementType    InventoryMovementType
  fromLocationId  String?
  toLocationId    String?
  employeeId      String?
  reason          String?
  inventoryItem   InventoryItem         @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  product         Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  fromLocation    WarehouseLocation?    @relation("MovementFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation      WarehouseLocation?    @relation("MovementToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  employee        Employee?             @relation("InventoryMovementEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt       DateTime              @default(now())

  @@index([inventoryItemId, createdAt])
  @@index([productId, createdAt])
  @@index([movementType, createdAt])
  @@index([employeeId])
}

model ProductImage {
  id                   String           @id @default(uuid())
  productId            String
  type                 ProductImageType
  originalUrl          String
  publicUrl            String?
  sortOrder            Int              @default(0)
  isRequired           Boolean          @default(false)
  uploadedByEmployeeId String?
  product              Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  uploadedBy           Employee?        @relation("ProductImageUploadedBy", fields: [uploadedByEmployeeId], references: [id])
  defects              ProductDefect[]
  createdAt            DateTime         @default(now())

  @@index([productId, type])
  @@index([uploadedByEmployeeId])
}

model ProductMeasurement {
  id                   String             @id @default(uuid())
  productId            String
  measurementType      String
  aiValueCm            Decimal?           @db.Decimal(6, 2)
  aiConfidence         Decimal?           @db.Decimal(4, 3)
  finalValueCm         Decimal?           @db.Decimal(6, 2)
  finalSource          MeasurementSource?
  reviewedByEmployeeId String?
  reviewedAt           DateTime?
  product              Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewedBy           Employee?          @relation("ProductMeasurementReviewedBy", fields: [reviewedByEmployeeId], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@unique([productId, measurementType])
  @@index([measurementType])
  @@index([reviewedByEmployeeId])
}

model AIExtraction {
  id                   String             @id @default(uuid())
  productId            String
  provider             String?
  model                String?
  promptVersion        String?
  requestJson          Json?
  inputImageIds        Json?
  rawOutputJson        Json?
  normalizedOutputJson Json?
  status               AIExtractionStatus @default(PENDING)
  errorMessage         String?
  failureCode          String?
  retryCount           Int                @default(0)
  startedAt            DateTime?
  completedAt          DateTime?
  latencyMs            Int?
  inputTokens          Int?
  outputTokens         Int?
  estimatedCostUsd     Decimal?           @db.Decimal(10, 6)
  product              Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  fieldDecisions       AIFieldDecision[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([productId, status])
  @@index([createdAt])
}

model AIFieldDecision {
  id                        String                @id @default(uuid())
  extractionId              String
  fieldName                 String
  aiValueJson               Json?
  finalValueJson            Json?
  confidence                Decimal?              @db.Decimal(4, 3)
  evidenceImageIds          Json?
  source                    AIFieldDecisionSource @default(AI_PROPOSED)
  requiresHumanConfirmation Boolean               @default(false)
  reviewedByEmployeeId      String?
  reviewedAt                DateTime?
  extraction                AIExtraction          @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  reviewedBy                Employee?             @relation("AIFieldDecisionReviewedBy", fields: [reviewedByEmployeeId], references: [id], onDelete: SetNull)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  @@unique([extractionId, fieldName])
  @@index([fieldName, source])
  @@index([reviewedByEmployeeId])
}

model ProductDefect {
  id                      String         @id @default(uuid())
  productId               String
  defectType              String
  severity                DefectSeverity
  description             String
  customerSafeDescription String?
  imageId                 String?
  product                 Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  image                   ProductImage?  @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdAt               DateTime       @default(now())

  @@index([productId])
  @@index([defectType])
  @@index([imageId])
}

model ProductReview {
  id                 String       @id @default(uuid())
  productId          String
  reviewerEmployeeId String?
  result             ReviewResult
  reason             String?
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewer           Employee?    @relation("ProductReviewReviewer", fields: [reviewerEmployeeId], references: [id])
  createdAt          DateTime     @default(now())

  @@index([productId, createdAt])
  @@index([reviewerEmployeeId])
}
